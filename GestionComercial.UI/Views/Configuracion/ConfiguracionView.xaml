<UserControl x:Class="GestionComercial.UI.Views.Configuracion.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GestionComercial.UI.Views.Converters"
             xmlns:controls="clr-namespace:GestionComercial.UI.Views.Controls"
             xmlns:views="clr-namespace:GestionComercial.UI.Views.Configuracion"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>

        <Style TargetType="TabControl">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="6">
                                <TabPanel IsItemsHost="True" Background="Transparent"/>
                            </Border>
                            <ContentPresenter Grid.Row="2" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground"      Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="18,8"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="8" Margin="2,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected"  Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccionBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelBtn" TargetType="Button">
            <Setter Property="Height"          Value="38"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="Margin"          Value="0,0,8,0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="CaretBrush"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormCombo" TargetType="ComboBox">
            <Setter Property="Height"              Value="40"/>
            <Setter Property="FontSize"            Value="13"/>
            <Setter Property="Background"          Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground"          Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"         Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness"     Value="1"/>
            <Setter Property="Padding"             Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
            <Setter Property="FocusVisualStyle"    Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>

                            <!-- ContentPresenter: muestra el item seleccionado -->
                            <ContentPresenter x:Name="contentPresenter"
                                              Grid.ColumnSpan="2"
                                              Margin="12,0,30,0"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              RecognizesAccessKey="True"/>

                            <!-- ToggleButton: maneja el abrir/cerrar dropdown -->
                            <ToggleButton x:Name="toggleButton"
                                          Grid.ColumnSpan="2"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Style="{StaticResource FilterComboBoxToggleButton}"/>

                            <!-- Popup: contiene la lista de items -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Grid.ColumnSpan="2"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide"
                                   Focusable="False">
                                <Border x:Name="DropDownBorder"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormPassword" TargetType="PasswordBox">
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="CaretBrush"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BadgeActivo" TargetType="Border">
            <Setter Property="CornerRadius"        Value="6"/>
            <Setter Property="Padding"             Value="10,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>

        <Style x:Key="BadgeSucursalActivo" TargetType="Border" BasedOn="{StaticResource BadgeActivo}">
            <Setter Property="Background" Value="#1A22C55E"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Activa}" Value="False">
                    <Setter Property="Background" Value="#1AEF4444"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BadgeUsuarioActivo" TargetType="Border" BasedOn="{StaticResource BadgeActivo}">
            <Setter Property="Background" Value="#1A22C55E"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Activo}" Value="False">
                    <Setter Property="Background" Value="#1AEF4444"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>

        <!-- ══ CONTENIDO PRINCIPAL ══════════════════════════════════════════ -->
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Configuración" FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Ajustes generales del sistema"
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
            </StackPanel>

            <TabControl Grid.Row="2">

                <!-- ── EMPRESA ────────────────────────────────────────────── -->
                <TabItem Visibility="{Binding MostrarTabsNormales, Converter={StaticResource BoolToVisibility}}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏢" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Empresa" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="28">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Datos de la empresa" FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Información general del negocio" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="AbrirPanel_Empresa"
                                        Style="{StaticResource PrimaryButton}"
                                        Height="38" Padding="16,0" FontSize="13" Click="AbrirPanel_Empresa_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✏️" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Editar" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Fila 0: Nombre, CUIT, Dirección -->
                                <StackPanel>
                                    <TextBlock Text="NOMBRE" Style="{StaticResource FormLabel}"/>
                                    <TextBlock Text="{Binding Empresa.Empresa.Nombre}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="CUIT" Style="{StaticResource FormLabel}"/>
                                    <TextBlock Text="{Binding Empresa.Empresa.CUIT}" FontSize="14"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="DIRECCIÓN" Style="{StaticResource FormLabel}"/>
                                    <TextBlock Text="{Binding Empresa.Empresa.Direccion}" FontSize="14"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <!-- Fila 1: Email, Teléfono -->
                                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                    <TextBlock Text="EMAIL" Style="{StaticResource FormLabel}"/>
                                    <TextBlock Text="{Binding Empresa.Empresa.Email, TargetNullValue='—'}" FontSize="14"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,16,0,0">
                                    <TextBlock Text="TELÉFONO" Style="{StaticResource FormLabel}"/>
                                    <TextBlock Text="{Binding Empresa.Empresa.Telefono, TargetNullValue='—'}" FontSize="14"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                                    <TextBlock Text="STOCK CRÍTICO (umbral global)" Style="{StaticResource FormLabel}"/>
                                    <TextBlock FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}">
                                        <Run Text="Menor a "/>
                                        <Run Text="{Binding Empresa.Empresa.UmbralStockCritico}"/>
                                        <Run Text=" unidades"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- ── SUCURSALES ─────────────────────────────────────────── -->
                <TabItem Visibility="{Binding MostrarTabsNormales, Converter={StaticResource BoolToVisibility}}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📍" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Sucursales" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="20,16,20,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Sucursales del negocio" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="8,0" Height="32">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Sucursales.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="🔍" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Button Grid.Column="4" Style="{StaticResource PrimaryButton}"
                                        Height="36" Padding="14,0" FontSize="12" Click="NuevaSucursal_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Nueva Sucursal" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                 <ItemsControl ItemsSource="{Binding Sucursales.Items}" Margin="12,0,12,12">
                                     <ItemsControl.ItemsPanel>
                                         <ItemsPanelTemplate>
                                             <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True"
                                                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                                                     VirtualizingPanel.ScrollUnit="Pixel"/>
                                         </ItemsPanelTemplate>
                                     </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceBrush}"
                                                    CornerRadius="10" Margin="0,0,0,8" Padding="16,12">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Activa}" Value="False">
                                                                <Setter Property="Opacity" Value="0.5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="40" Height="40" CornerRadius="10"
                                                            Background="{DynamicResource PrimaryBrush}" Margin="0,0,14,0">
                                                        <TextBlock Text="🏪" FontSize="18"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Nombre}" FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Direccion}" FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Style="{StaticResource BadgeSucursalActivo}" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding EstadoTexto}" FontSize="11" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Activa}" Value="False">
                                                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <Button Grid.Column="3" Content="✏️ Editar"
                                                            Style="{StaticResource AccionBtn}"
                                                            Tag="{Binding}" Click="EditarSucursal_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- ── USUARIOS ───────────────────────────────────────────── -->
                <TabItem Visibility="{Binding MostrarTabsNormales, Converter={StaticResource BoolToVisibility}}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Usuarios" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="20,16,20,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Usuarios del sistema" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="8,0" Height="32">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Usuarios.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="🔍" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Button Grid.Column="4" Style="{StaticResource PrimaryButton}"
                                        Height="36" Padding="14,0" FontSize="12" Click="NuevoUsuario_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Nuevo Usuario" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                 <ItemsControl ItemsSource="{Binding Usuarios.Items}" Margin="12,0,12,12">
                                     <ItemsControl.ItemsPanel>
                                         <ItemsPanelTemplate>
                                             <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True"
                                                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                                                     VirtualizingPanel.ScrollUnit="Pixel"/>
                                         </ItemsPanelTemplate>
                                     </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceBrush}"
                                                    CornerRadius="10" Margin="0,0,0,8" Padding="16,12">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                <Setter Property="Opacity" Value="0.5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="40" Height="40" CornerRadius="20"
                                                            Background="{DynamicResource PrimaryBrush}" Margin="0,0,14,0">
                                                        <TextBlock Text="{Binding Inicial}" FontSize="16" FontWeight="Bold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding NombreCompleto}" FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding Rol}" FontSize="11"
                                                                       Foreground="{DynamicResource PrimaryBrush}"/>
                                                            <TextBlock Text=" · " FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding SucursalNombre}" FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="✏️ Editar"
                                                            Style="{StaticResource AccionBtn}"
                                                            Tag="{Binding}" Click="EditarUsuario_Click"/>
                                                    <Button Grid.Column="3" Tag="{Binding}"
                                                            Style="{StaticResource AccionBtn}"
                                                            Padding="12,4" Cursor="Hand"
                                                            Click="UsuarioToggleActivo_Click">
                                                        <Border Background="#1A22C55E"
                                                                CornerRadius="6" Padding="10,3">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#1A22C55E"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                            <Setter Property="Background" Value="#1AEF4444"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="11" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text"       Value="Activo"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                                <Setter Property="Text"       Value="Inactivo"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- ── ROLES ──────────────────────────────────────────────── -->
                <TabItem Visibility="{Binding MostrarRoles, Converter={StaticResource BoolToVisibility}}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔑" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Roles y Permisos" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Fila 0: Header -->
                            <Grid Margin="20,16,20,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Roles de usuario" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                        Height="36" Padding="14,0" FontSize="12" Click="NuevoRol_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Nuevo Rol" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Fila 1: Split roles (izquierda) + permisos (derecha) -->
                            <Grid Grid.Row="1" Margin="12,0,12,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Col 0: Lista de roles (ListBox con SelectionChanged) -->
                                <ListBox Grid.Column="0"
                                         ItemsSource="{Binding Roles.Items}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         SelectionChanged="RolesListBox_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceBrush}"
                                                    CornerRadius="10" Margin="0,0,0,8" Padding="14,12"
                                                    BorderBrush="Transparent" BorderThickness="2"
                                                    Cursor="Hand">
                                                <Border.Style>
                                                    <Style TargetType="Border"/>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="36" Height="36" CornerRadius="8"
                                                            Background="#1A3B82F6" Margin="0,0,12,0">
                                                        <TextBlock Text="🔑" FontSize="16"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Nombre}" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0">
                                                            <Run Text="{Binding CantidadPermisos}"/>
                                                            <Run Text=" permisos"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="✏️"
                                                            Style="{StaticResource AccionBtn}"
                                                            Tag="{Binding}" Click="EditarRol_Click"/>
                                                    <Button Grid.Column="3" Content="🗑️"
                                                            Style="{StaticResource AccionBtn}"
                                                            Tag="{Binding}" Click="EliminarRol_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Col 2: Toggles de módulos para el rol seleccionado -->
                                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding Roles.MostrarPermisos, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="16" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                                    <Run Text="Módulos para "/>
                                                    <Run Text="{Binding Roles.Seleccionado.Nombre}"/>
                                                </TextBlock>
                                                <TextBlock Text="Activá o desactivá módulos para este rol"
                                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Height="36" Padding="16,0" FontSize="12"
                                                    IsEnabled="{Binding Roles.PuedeGuardarPermisos}"
                                                    Click="GuardarPermisos_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="💾" FontSize="13" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Guardar"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Roles.Modulos}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True"
                                                                            VirtualizingPanel.VirtualizationMode="Recycling"
                                                                            VirtualizingPanel.ScrollUnit="Pixel"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SurfaceBrush}"
                                                            CornerRadius="10" Margin="0,0,0,8" Padding="16,14">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Nombre}" FontSize="14" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            </StackPanel>
                                                            <ToggleButton Grid.Column="1"
                                                                          IsChecked="{Binding Activo}"
                                                                          Width="44" Height="24"
                                                                          Cursor="Hand"
                                                                          VerticalAlignment="Center">
                                                                <ToggleButton.Style>
                                                                    <Style TargetType="ToggleButton">
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="ToggleButton">
                                                                                    <Border x:Name="Bg"
                                                                                            Width="44" Height="24"
                                                                                            CornerRadius="12"
                                                                                            Background="{DynamicResource TextSecondaryBrush}"
                                                                                            Cursor="Hand">
                                                                                        <Border x:Name="Thumb"
                                                                                                Width="20" Height="20"
                                                                                                CornerRadius="10"
                                                                                                Background="White"
                                                                                                HorizontalAlignment="Left"
                                                                                                Margin="2,0,0,0"
                                                                                                BorderBrush="#30000000"
                                                                                                BorderThickness="1"/>
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsChecked" Value="True">
                                                                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                                                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                                                                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                                                                                        </Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Style>
                                                                </ToggleButton.Style>
                                                            </ToggleButton>
                                                            <Button Grid.Column="2" Content="🗑️"
                                                                    Style="{StaticResource AccionBtn}"
                                                                    Tag="{Binding Nombre}"
                                                                    Click="RemoverPermiso_Click"
                                                                    ToolTip="Remover permisos de este módulo"
                                                                    Margin="8,0,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Placeholder cuando no hay rol seleccionado -->
                                <Border Grid.Column="2"
                                        Background="{DynamicResource SurfaceBrush}"
                                        CornerRadius="12" Padding="24">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Roles.MostrarPermisos}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="🔑" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                        <TextBlock Text="Seleccioná un rol" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="para ver y editar sus permisos" FontSize="13"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- ── MÉTODOS DE PAGO ────────────────────────────────────── -->
                <TabItem Visibility="{Binding MostrarTabsNormales, Converter={StaticResource BoolToVisibility}}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💳" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Métodos de Pago" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="20,16,20,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Métodos de pago aceptados" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                        Height="36" Padding="14,0" FontSize="12" Click="NuevoMetodo_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Nuevo Método" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                 <ItemsControl ItemsSource="{Binding MetodosPago.Items}" Margin="12,0,12,12">
                                     <ItemsControl.ItemsPanel>
                                         <ItemsPanelTemplate>
                                             <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True"
                                                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                                                     VirtualizingPanel.ScrollUnit="Pixel"/>
                                         </ItemsPanelTemplate>
                                     </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceBrush}"
                                                    CornerRadius="10" Margin="0,0,0,8" Padding="16,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="36" Height="36" CornerRadius="8"
                                                            Background="#1A3B82F6" Margin="0,0,14,0">
                                                        <TextBlock Text="{Binding Icono}" FontSize="18"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Nombre}" FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding TipoTexto}" FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="✏️ Editar"
                                                            Style="{StaticResource AccionBtn}" Margin="0,0,6,0"
                                                            Tag="{Binding}" Click="EditarMetodo_Click"/>
                                                    <Button Grid.Column="3" Content="🗑️"
                                                            Style="{StaticResource AccionBtn}"
                                                            Tag="{Binding}" Click="EliminarMetodo_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                 </TabItem>

                <!-- ── BACKUP ────────────────────────────────────────────── -->
                <TabItem Visibility="{Binding MostrarBackup, Converter={StaticResource BoolToVisibility}}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Backup" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Background="{DynamicResource CardBrush}" Margin="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Fila 0: Título + Botón manual -->
                        <Grid Grid.Row="0" Margin="20,16,20,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Backup de la base de datos" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Copia de seguridad de la información del sistema" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                    Height="36" Padding="14,0" FontSize="12"
                                    Click="BackupManual_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📦" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Realizar Backup" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Fila 1: Carpeta destino -->
                        <Grid Grid.Row="1" Margin="20,0,20,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Carpeta destino" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding Backup.CarpetaDestino, Mode=OneWay}"
                                     IsReadOnly="True" Height="36" FontSize="12" Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     Background="{DynamicResource SurfaceBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                            <Button Grid.Column="3" Style="{StaticResource SecondaryButton}"
                                    Height="36" Padding="14,0" FontSize="12"
                                    Click="CambiarCarpetaBackup_Click">Cambiar</Button>
                        </Grid>

                        <!-- Fila 2: Frecuencia + Día + Hora -->
                        <Grid Grid.Row="2" Margin="20,0,20,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Frecuencia" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <ComboBox Style="{StaticResource FormCombo}"
                                          ItemsSource="{Binding Backup.FrecuenciasDisponibles}"
                                          SelectedItem="{Binding Backup.FrecuenciaSeleccionada}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescription}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Día de la semana" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <ComboBox Style="{StaticResource FormCombo}"
                                          ItemsSource="{Binding Backup.DiasSemana}"
                                          SelectedItem="{Binding Backup.DiaSemanaSeleccionadoItem}"
                                          DisplayMemberPath="Nombre"
                                          IsEnabled="{Binding Backup.DiaSemanaHabilitado}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Hora programada" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <controls:ClockTimePicker Hour="{Binding Backup.HoraSeleccionada}"
                                                           Minute="{Binding Backup.MinutoSeleccionado}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Fila 3: MaxBackups + Último + Guardar -->
                        <Grid Grid.Row="3" Margin="20,0,20,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Máx. backups a conservar" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Backup.MaxBackups, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormInput}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Último backup" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding Backup.UltimoBackupFormato}" FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Height="40"/>
                            </StackPanel>
                            <Button Grid.Column="4" Style="{StaticResource PrimaryButton}"
                                    Height="36" Padding="14,0" FontSize="12"
                                    VerticalAlignment="Bottom"
                                    Click="GuardarConfigBackup_Click">Guardar</Button>
                        </Grid>

<!-- Fila 4: Lista de backups existentes -->
                                <Border Grid.Row="4" Margin="20,0,20,16"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                                                Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                            <TextBlock Text="  Backups existentes" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Padding="12,10,0,10"/>
                                        </Border>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Backup.Backups}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True"
                                                                            VirtualizingPanel.VirtualizationMode="Recycling"
                                                                            VirtualizingPanel.ScrollUnit="Pixel"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="12,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="40"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding FileName}" FontSize="12"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding FileSizeBytes, Converter={StaticResource TamanioArchivo}}"
                                                               FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding CreatedAt, StringFormat='dd/MM/yyyy HH:mm'}"
                                                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <Button Grid.Column="3" Content="🗑️"
                                                            Style="{StaticResource AccionBtn}" Padding="4,2"
                                                            ToolTip="Eliminar backup"
                                                            Tag="{Binding}" Click="EliminarBackup_Click"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                    </Grid>
                </TabItem>

                <!-- ── DESCUENTOS ──────────────────────────────────────────── -->
                <TabItem Visibility="{Binding MostrarDescuentos, Converter={StaticResource BoolToVisibility}}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💰" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Descuentos" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: Header (título + búsqueda + botón) -->
                            <Grid Grid.Row="0" Margin="20,16,20,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Descuentos configurados" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="8,0" Height="32">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Descuentos.TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="🔍" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Button Grid.Column="4" Style="{StaticResource PrimaryButton}"
                                        Height="36" Padding="14,0" FontSize="12"
                                        Click="NuevoDescuento_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Nuevo Descuento" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Row 1: Filter Panel -->
                            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                                    CornerRadius="8" Padding="10" Margin="12,0,12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Tipo:" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Descuentos.TiposDescuento}"
                                              SelectedItem="{Binding Descuentos.FiltroTipo}"
                                              Style="{StaticResource FormCombo}" Height="30" FontSize="12"/>
                                    <TextBlock Grid.Column="3" Text="Método Pago:" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <ComboBox Grid.Column="4" ItemsSource="{Binding Descuentos.MetodosPago}"
                                              SelectedItem="{Binding Descuentos.FiltroMetodoPago}"
                                              Style="{StaticResource FormCombo}" Height="30" FontSize="12"/>
                                    <Button Grid.Column="6" Content="🔄"
                                            Width="30" Height="30" FontSize="14" Padding="0"
                                            Style="{StaticResource AccionBtn}" ToolTip="Limpiar filtros"
                                            Click="LimpiarFiltros_Click"/>
                                </Grid>
                            </Border>

                            <!-- Row 2: Contenido (lista OR formulario) -->
                            <Grid Grid.Row="2">

                                <!-- Vista lista -->
                                <DataGrid Margin="12,0,12,12"
                                          AutoGenerateColumns="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="None"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          RowBackground="{DynamicResource CardBrush}"
                                          AlternatingRowBackground="{DynamicResource SurfaceBrush}"
                                          SelectionMode="Single"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserSortColumns="False"
                                          CanUserResizeColumns="False"
                                          CanUserReorderColumns="False"
                                          MouseDoubleClick="DescuentosDataGrid_MouseDoubleClick"
                                          ItemsSource="{Binding Descuentos.Items}">
                                    <DataGrid.Style>
                                        <Style TargetType="DataGrid">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </Style>
                                    </DataGrid.Style>
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="Padding" Value="8,8"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="13"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Margin" Value="8,0"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="110">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                    <Setter Property="Margin" Value="8,0"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Producto/Categoría" Binding="{Binding ObjetoNombre}" Width="170">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                    <Setter Property="Margin" Value="8,0"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Método Pago" Binding="{Binding MetodoPagoNombre}" Width="160">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                    <Setter Property="Margin" Value="8,0"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Valor" Binding="{Binding Valor}" Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="13"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Margin" Value="8,0"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="Estado" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Click="DescuentoToggleActivo_Click"
                                                            Tag="{Binding}"
                                                            Style="{StaticResource AccionBtn}"
                                                            Padding="12,4" Margin="12,4"
                                                            Cursor="Hand">
                                                        <Border Background="#1A22C55E"
                                                                CornerRadius="6" Padding="10,3"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#1A22C55E"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                            <Setter Property="Background" Value="#1AEF4444"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="11" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text"       Value="Activo"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                                <Setter Property="Text"       Value="Inactivo"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Vista formulario como modal popup -->
                                <Border Grid.RowSpan="3"
                                        Background="#88000000"
                                        DataContext="{Binding Descuentos.Formulario}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.Descuentos.MostrarFormulario, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
<Popup IsOpen="{Binding DataContext.Descuentos.MostrarFormulario, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                           AllowsTransparency="True"
                                           Placement="Center"
                                           PopupAnimation="Fade"
                                           Focusable="True">
                                        <Border Background="{DynamicResource BackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="24"
                                                MinWidth="500"
                                                MaxWidth="900"
                                                MaxHeight="600"
                                                Margin="40">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="0" Opacity="0.3"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="460">
                                                    <StackPanel>

                                                        <!-- Header del formulario -->
                                        <Grid Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="16" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Nuevo Descuento"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EsModoEdicion}" Value="True">
                                                                <Setter Property="Text" Value="Editar Descuento"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Grid.Column="1" Content="✕" Style="{StaticResource AccionBtn}"
                                                    FontSize="14" Click="CerrarDescuentoForm_Click"/>
                                        </Grid>

                                        <!-- Sección: QUÉ SE COMPRA -->
                                        <TextBlock Text="QUÉ SE COMPRA" Style="{StaticResource FormLabel}"/>
                                        <Border Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="10" Padding="16,14" Margin="0,0,0,16">
                                            <StackPanel>
                                                <!-- RadioButtons -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <RadioButton Content="Producto"
                                                                 GroupName="AmbitoDescuento" Margin="0,0,16,0"
                                                                 FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                                                 Click="AmbitoProducto_Click"/>
                                                    <RadioButton Content="Categoría"
                                                                 GroupName="AmbitoDescuento" Margin="0,0,16,0"
                                                                 FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                                                 Click="AmbitoCategoria_Click"/>
                                                    <RadioButton Content="Método de Pago"
                                                                 GroupName="AmbitoDescuento" Margin="0,0,16,0"
                                                                 FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                                                 Click="AmbitoMetodoPago_Click"/>
                                                    <RadioButton Content="Compra Mayor"
                                                                 GroupName="AmbitoDescuento"
                                                                 FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                                                 Click="AmbitoCompraMayor_Click"/>
                                                </StackPanel>

                                                <!-- Selector Producto -->
                                                <StackPanel Visibility="{Binding MuestraSelectorProducto, Converter={StaticResource BoolToVisibility}}"
                                                            Margin="0,0,0,8">
                                                    <TextBlock Text="Producto" Style="{StaticResource FormLabel}"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0"
                                                                 Text="{Binding TextoBusquedaProducto, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource FormInput}" Margin="0,0,0,0"/>
                                                        <Button Grid.Column="1" Content="🔍" Width="30" Height="40"
                                                                Style="{StaticResource AccionBtn}" Padding="0"
                                                                Click="BuscarProducto_Click"/>
                                                    </Grid>
                                                    <ListBox ItemsSource="{Binding ProductosFiltrados}"
                                                             SelectedItem="{Binding ProductoSeleccionadoBusqueda}"
                                                             MaxHeight="150" Margin="0,4,0,0"
                                                             Background="{DynamicResource CardBrush}"
                                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                                             Visibility="{Binding MostrarListaProductos, Converter={StaticResource BoolToVisibility}}">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Nombre}" FontSize="12"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           Padding="8,4"/>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>

                                                <!-- Selector Categoría - Direct list, no search -->
                                                <StackPanel Visibility="{Binding MuestraSelectorCategoria, Converter={StaticResource BoolToVisibility}}"
                                                            Margin="0,0,0,8">
                                                    <TextBlock Text="Categoría" Style="{StaticResource FormLabel}"/>
                                                    <ComboBox ItemsSource="{Binding Categorias}"
                                                              SelectedItem="{Binding CategoriaSeleccionada}"
                                                              DisplayMemberPath="Nombre"
                                                              Style="{StaticResource FormCombo}"/>
                                                </StackPanel>

                                                <!-- Compra Mayor: Monto Mínimo -->
                                                <StackPanel Visibility="{Binding MuestraCompraMinima, Converter={StaticResource BoolToVisibility}}"
                                                            Margin="0,0,0,8">
                                                    <TextBlock Text="Monto Mínimo de Compra ($)" Style="{StaticResource FormLabel}"/>
                                                    <TextBox Text="{Binding MontoMinimoCompra, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource FormInput}"/>
                                                    <TextBlock Text="El descuento se aplica cuando la venta supere este monto."
                                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Sección: CONDICIÓN DE PAGO -->
                                        <TextBlock Text="CONDICIÓN DE PAGO" Style="{StaticResource FormLabel}"/>
                                        <Border Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="10" Padding="16,14" Margin="0,0,0,16">
                                            <StackPanel>
                                                <CheckBox Content="Aplica a cualquier método de pago"
                                                          IsChecked="{Binding AplicaCualquierMetodoPago}"
                                                          Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                                                          Margin="0,0,0,10"/>
                                                <ItemsControl ItemsSource="{Binding MetodosPagoDisponibles}"
                                                              Visibility="{Binding MuestraSelectorMetodosPago, Converter={StaticResource BoolToVisibility}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding MetodoPago.Nombre}"
                                                                      IsChecked="{Binding EstaSeleccionado, Mode=TwoWay}"
                                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                                      FontSize="13" Margin="0,0,0,4"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Sección: DATOS -->
                                        <TextBlock Text="DATOS" Style="{StaticResource FormLabel}"/>
                                        <Border Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="10" Padding="16,14" Margin="0,0,0,16">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Nombre (editable, span all columns) -->
                                                <StackPanel Grid.Row="0" Grid.ColumnSpan="5">
                                                    <TextBlock Text="Nombre" Style="{StaticResource FormLabel}"/>
                                                    <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource FormInput}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                                    <TextBlock Text="Valor (%)" Style="{StaticResource FormLabel}"/>
                                                    <TextBox Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource FormInput}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,16,0,0">
                                                    <TextBlock Text="Fecha Desde" Style="{StaticResource FormLabel}"/>
                                                    <DatePicker SelectedDate="{Binding FechaDesde}"
                                                                FontSize="13" Height="40"
                                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                                Background="{DynamicResource SurfaceBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="4" Grid.Row="1" Margin="0,16,0,0">
                                                    <TextBlock Text="Fecha Hasta" Style="{StaticResource FormLabel}"/>
                                                    <DatePicker SelectedDate="{Binding FechaHasta}"
                                                                FontSize="13" Height="40"
                                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                                Background="{DynamicResource SurfaceBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Error -->
                                        <Border Background="#1AEF4444" CornerRadius="8" Padding="12,8"
                                                Visibility="{Binding TieneError, Converter={StaticResource BoolToVisibility}}"
                                                Margin="0,0,0,16">
                                            <TextBlock Text="{Binding MensajeError}" FontSize="12"
                                                       Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
                                        </Border>

</StackPanel>
                            </ScrollViewer>
                            <!-- Botones (siempre visibles fuera del scroll) -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Content="Cancelar" Style="{StaticResource CancelBtn}"
                                        Click="DescuentoCancelar_Click"/>
                                <Button Content="Guardar" Style="{StaticResource PrimaryButton}"
                                        Height="38" Padding="16,0"
                                        Click="DescuentoGuardar_Click"/>
                            </StackPanel>
                        </Grid>
                                        </Border>
                                    </Popup>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </TabItem>

             </TabControl>
        </Grid>

        <!-- ══ OVERLAY ══════════════════════════════════════════════════════ -->
        <Rectangle x:Name="Overlay" Fill="#88000000" Opacity="0" IsHitTestVisible="False"/>

        <!-- Panel Empresa -->
        <Border x:Name="PanelEmpresa" Width="400" HorizontalAlignment="Right"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <Border.RenderTransform><TranslateTransform x:Name="PanelEmpresaTransform"/></Border.RenderTransform>
            <Grid Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="Editar Empresa" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Button HorizontalAlignment="Right" Content="✕" Style="{StaticResource AccionBtn}"
                            FontSize="14" Click="CerrarPanel_Click"/>
                </Grid>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="NOMBRE" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding Empresa.EditNombre, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormInput}" Margin="0,0,0,16"/>

                        <TextBlock Text="CUIT" Style="{StaticResource FormLabel}"/>
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Empresa.Empresa.CUIT}" FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="🔒 No editable" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="DIRECCIÓN" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding Empresa.EditDireccion, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormInput}" Margin="0,0,0,16"/>

                        <TextBlock Text="EMAIL" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding Empresa.EditEmail, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormInput}" Margin="0,0,0,16"/>

                        <TextBlock Text="TELÉFONO" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding Empresa.EditTelefono, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormInput}" Margin="0,0,0,16"/>

                        <TextBlock Text="UMBRAL STOCK CRÍTICO" Style="{StaticResource FormLabel}"/>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,6">
                            Mostrar alerta cuando el stock sea menor a esta cantidad.
                        </TextBlock>
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,0" Height="40" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&lt;" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Empresa.EditUmbralStockCritico, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontSize="14" FontWeight="Bold"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="unidades" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Background="#1AEF4444" CornerRadius="8" Padding="12,8"
                                Visibility="{Binding Empresa.TieneError, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Empresa.MensajeError}" FontSize="12"
                                       Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Cancelar" Style="{StaticResource CancelBtn}" Click="CerrarPanel_Click"/>
                    <Button Content="Guardar" Style="{StaticResource PrimaryButton}"
                            Height="38" Padding="16,0" Click="GuardarEmpresa_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Panel Sucursales -->
        <Border x:Name="PanelSucursal" Width="360" HorizontalAlignment="Right"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <Border.RenderTransform><TranslateTransform x:Name="PanelSucursalTransform"/></Border.RenderTransform>
            <Grid Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="{Binding Sucursales.TituloPanel}" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Button HorizontalAlignment="Right" Content="✕" Style="{StaticResource AccionBtn}"
                            FontSize="14" Click="CerrarPanel_Click"/>
                </Grid>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="NOMBRE" Style="{StaticResource FormLabel}"/>
                    <TextBox Text="{Binding Sucursales.EditNombre, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormInput}" Margin="0,0,0,16"/>
                    <TextBlock Text="DIRECCIÓN" Style="{StaticResource FormLabel}"/>
                    <TextBox Text="{Binding Sucursales.EditDireccion, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormInput}" Margin="0,0,0,16"/>
                    <CheckBox Content="Sucursal activa" IsChecked="{Binding Sucursales.EditActiva}"
                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                    <Border Background="#1AEF4444" CornerRadius="8" Padding="12,8" Margin="0,12,0,0"
                            Visibility="{Binding Sucursales.TieneError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Sucursales.MensajeError}" FontSize="12"
                                   Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource CancelBtn}" Click="CerrarPanel_Click"/>
                    <Button Content="Guardar" Style="{StaticResource PrimaryButton}"
                            Height="38" Padding="16,0" Click="GuardarSucursal_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Panel Usuarios -->
        <Border x:Name="PanelUsuario" Width="380" HorizontalAlignment="Right"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <Border.RenderTransform><TranslateTransform x:Name="PanelUsuarioTransform"/></Border.RenderTransform>
            <Grid Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="{Binding Usuarios.TituloPanel}" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Button HorizontalAlignment="Right" Content="✕" Style="{StaticResource AccionBtn}"
                            FontSize="14" Click="CerrarPanel_Click"/>
                </Grid>
                <StackPanel Grid.Row="2">
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="NOMBRE" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding Usuarios.EditNombre, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormInput}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="APELLIDO" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding Usuarios.EditApellido, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormInput}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="CONTRASEÑA" Style="{StaticResource FormLabel}"/>
                    <PasswordBox x:Name="PbUsuario" Style="{StaticResource FormPassword}"
                                 PasswordChanged="PbUsuario_PasswordChanged" Margin="0,0,0,16"/>
                    <TextBlock Text="SUCURSAL" Style="{StaticResource FormLabel}"/>
                    <ComboBox ItemsSource="{Binding Usuarios.Sucursales}"
                              SelectedItem="{Binding Usuarios.EditSucursal}"
                              DisplayMemberPath="Nombre" Height="40" Margin="0,0,0,16"
                              Style="{StaticResource FilterComboBoxStyle}"/>
                    <TextBlock Text="ROL" Style="{StaticResource FormLabel}"/>
                    <ComboBox ItemsSource="{Binding Usuarios.Roles}"
                              SelectedItem="{Binding Usuarios.EditRol}"
                              DisplayMemberPath="Nombre" Height="40" Margin="0,0,0,16"
                              Style="{StaticResource FilterComboBoxStyle}"/>
                    <CheckBox Content="Usuario activo" IsChecked="{Binding Usuarios.EditActivo}"
                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                    <Border Background="#1AEF4444" CornerRadius="8" Padding="12,8" Margin="0,12,0,0"
                            Visibility="{Binding Usuarios.TieneError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Usuarios.MensajeError}" FontSize="12"
                                   Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource CancelBtn}" Click="CerrarPanel_Click"/>
                    <Button Content="Guardar" Style="{StaticResource PrimaryButton}"
                            Height="38" Padding="16,0" Click="GuardarUsuario_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Panel Roles -->
        <Border x:Name="PanelRol" Width="340" HorizontalAlignment="Right"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <Border.RenderTransform><TranslateTransform x:Name="PanelRolTransform"/></Border.RenderTransform>
            <Grid Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="{Binding Roles.TituloPanel}" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Button HorizontalAlignment="Right" Content="✕" Style="{StaticResource AccionBtn}"
                            FontSize="14" Click="CerrarPanel_Click"/>
                </Grid>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="NOMBRE DEL ROL" Style="{StaticResource FormLabel}"/>
                    <TextBox Text="{Binding Roles.EditNombre, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormInput}"/>
                    <Border Background="#1AEF4444" CornerRadius="8" Padding="12,8" Margin="0,12,0,0"
                            Visibility="{Binding Roles.TieneError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Roles.MensajeError}" FontSize="12"
                                   Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource CancelBtn}" Click="CerrarPanel_Click"/>
                    <Button Content="Guardar" Style="{StaticResource PrimaryButton}"
                            Height="38" Padding="16,0" Click="GuardarRol_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Panel Métodos de Pago -->
        <Border x:Name="PanelMetodo" Width="340" HorizontalAlignment="Right"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <Border.RenderTransform><TranslateTransform x:Name="PanelMetodoTransform"/></Border.RenderTransform>
            <Grid Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="{Binding MetodosPago.TituloPanel}" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Button HorizontalAlignment="Right" Content="✕" Style="{StaticResource AccionBtn}"
                            FontSize="14" Click="CerrarPanel_Click"/>
                </Grid>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="NOMBRE" Style="{StaticResource FormLabel}"/>
                    <TextBox Text="{Binding MetodosPago.EditNombre, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormInput}" Margin="0,0,0,16"/>
                    <TextBlock Text="TIPO" Style="{StaticResource FormLabel}"/>
                    <ComboBox SelectedValue="{Binding MetodosPago.EditCategoria}" SelectedValuePath="Content"
                              Style="{StaticResource FormCombo}" Margin="0,0,0,16">
                        <ComboBoxItem Content="Efectivo"/>
                        <ComboBoxItem Content="Tarjeta"/>
                        <ComboBoxItem Content="Transferencia"/>
                        <ComboBoxItem Content="Otro"/>
                    </ComboBox>
                    <StackPanel Visibility="{Binding MetodosPago.MostrarSubcategoria, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="CATEGORÍA" Style="{StaticResource FormLabel}"/>
                        <ComboBox SelectedValue="{Binding MetodosPago.EditSubcategoria}" SelectedValuePath="Content"
                                  Style="{StaticResource FormCombo}" Margin="0,0,0,16">
                            <ComboBoxItem Content="Credito"/>
                            <ComboBoxItem Content="Debito"/>
                        </ComboBox>
                    </StackPanel>
                    <Border Background="#1AEF4444" CornerRadius="8" Padding="12,8" Margin="0,12,0,0"
                            Visibility="{Binding MetodosPago.TieneError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding MetodosPago.MensajeError}" FontSize="12"
                                   Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource CancelBtn}" Click="CerrarPanel_Click"/>
                    <Button Content="Guardar" Style="{StaticResource PrimaryButton}"
                            Height="38" Padding="16,0" Click="GuardarMetodo_Click"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
