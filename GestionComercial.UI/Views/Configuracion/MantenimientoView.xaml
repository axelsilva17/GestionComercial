<UserControl x:Class="GestionComercial.UI.Views.Configuracion.MantenimientoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="CaretBrush"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MantBtn" TargetType="Button">
            <Setter Property="Height"          Value="38"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="&#x1f527; Panel de Mantenimiento" FontSize="26" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Herramientas de diagnóstico y mantenimiento del sistema"
                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Loading -->
                <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                        Background="{DynamicResource SurfaceBrush}" CornerRadius="10"
                        Padding="16" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏳" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Procesando..." FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Mensaje estado -->
                <Border Visibility="{Binding MensajeEstado, Converter={StaticResource NullToVisibility}}"
                        Background="{DynamicResource SurfaceBrush}" CornerRadius="10"
                        Padding="16" Margin="0,0,0,12">
                    <TextBlock Text="{Binding MensajeEstado}" FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                </Border>

                <!-- DIAGNÓSTICO -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="DIAGNÓSTICO" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                        <Button Content="&#x1f50d; Ejecutar Auditoría Completa" Style="{StaticResource MantBtn}"
                                HorizontalAlignment="Left" Click="EjecutarAuditoria_Click"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"/>

                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                                Padding="14" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="Integridad DB: "/>
                                    <Run Text="{Binding IntegridadOk, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding ResultadoAuditoria}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding ResultadoAuditoria, Converter={StaticResource NullToVisibility}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- BASE DE DATOS -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="BASE DE DATOS" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="&#x26a1; Optimizar" Style="{StaticResource MantBtn}"
                                    Margin="0,0,8,0" Click="Optimizar_Click"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"/>
                            <Button Content="&#x1f504; Reindexar" Style="{StaticResource MantBtn}"
                                    Margin="0,0,8,0" Click="Reindexar_Click"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"/>
                            <Button Content="&#x1f9f9; Limpiar" Style="{StaticResource MantBtn}"
                                    Click="Limpiar_Click"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- BACKUP -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="BACKUP" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="&#x1f4be; Verificar Backup" Style="{StaticResource MantBtn}"
                                    Click="VerificarBackup_Click"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ACTUALIZACIONES -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ACTUALIZACIONES" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8">
                            <Run Text="Versión actual: "/>
                            <Run Text="{Binding VersionActual, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Ruta:" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding RutaActualizacion, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormInput}" Width="300" Height="32" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="&#x1f4e6; Buscar" Style="{StaticResource MantBtn}"
                                    Margin="0,0,8,0" Click="BuscarActualizacion_Click"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"/>
                            <Button Content="&#x1f504; Aplicar" Style="{StaticResource MantBtn}"
                                    Click="AplicarActualizacion_Click"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- REPORTE -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="REPORTE" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="&#x1f4c4; Generar Reporte" Style="{StaticResource MantBtn}"
                                    Margin="0,0,8,0" Click="GenerarReporte_Click"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"/>
                            <Button Content="&#x1f4c4; Exportar PDF" Style="{StaticResource MantBtn}"
                                    Click="ExportarPdf_Click"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"/>
                        </StackPanel>
                        <Border Visibility="{Binding ReporteGenerado, Converter={StaticResource NullToVisibility}}"
                                Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                                Padding="14" Margin="0,8,0,0" MaxHeight="200">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding ReporteGenerado}" FontSize="11"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" FontFamily="Consolas"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
