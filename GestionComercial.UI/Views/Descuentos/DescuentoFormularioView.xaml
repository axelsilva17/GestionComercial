<UserControl x:Class="GestionComercial.UI.Views.Descuentos.DescuentoFormularioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cal="http://www.caliburnproject.org"
             Background="Transparent">

    <Grid Margin="20" MaxWidth="500" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="{Binding Titulo}" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

        <!-- Form -->
        <StackPanel Grid.Row="1">
            <!-- Error -->
            <Border Background="#1AEF4444" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                    Visibility="{Binding TieneError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding MensajeError}" FontSize="12"
                           Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
            </Border>

            <!-- Tipo -->
            <TextBlock Text="TIPO" Style="{StaticResource FormLabel}"/>
            <ComboBox Height="36" Margin="0,0,0,12" FontSize="13"
                      SelectedValue="{Binding TipoSeleccionadoStr, Mode=TwoWay}"
                      SelectedValuePath="Tag"
                      IsEnabled="{Binding EsModoEdicion, Converter={StaticResource InverseBool}}">
                <ComboBoxItem Content="Producto" Tag="Producto"/>
                <ComboBoxItem Content="Categoría" Tag="Categoria"/>
                <ComboBoxItem Content="Método de Pago" Tag="MetodoPago"/>
            </ComboBox>

            <!-- Selector de Producto (visible cuando Tipo = Producto) -->
            <StackPanel Visibility="{Binding EsTipoProducto, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="PRODUCTO" Style="{StaticResource FormLabel}"/>
                <ComboBox ItemsSource="{Binding Productos}"
                          DisplayMemberPath="Nombre"
                          SelectedItem="{Binding ProductoSeleccionado}"
                          IsEnabled="{Binding EsModoEdicion, Converter={StaticResource InverseBool}}"
                          Height="36" Margin="0,0,0,12" FontSize="13"/>
            </StackPanel>

            <!-- Selector de Categoría (visible cuando Tipo = Categoria) -->
            <StackPanel Visibility="{Binding EsTipoCategoria, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="CATEGORÍA" Style="{StaticResource FormLabel}"/>
                <ComboBox ItemsSource="{Binding Categorias}"
                          DisplayMemberPath="Nombre"
                          SelectedItem="{Binding CategoriaSeleccionada}"
                          IsEnabled="{Binding EsModoEdicion, Converter={StaticResource InverseBool}}"
                          Height="36" Margin="0,0,0,12" FontSize="13"/>
            </StackPanel>

            <!-- Selector de Método de Pago (visible cuando Tipo = MetodoPago) -->
            <StackPanel Visibility="{Binding EsTipoMetodoPago, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="MÉTODO DE PAGO" Style="{StaticResource FormLabel}"/>
                <ComboBox ItemsSource="{Binding MetodosPago}"
                          DisplayMemberPath="Nombre"
                          SelectedItem="{Binding MetodoPagoSeleccionado}"
                          IsEnabled="{Binding EsModoEdicion, Converter={StaticResource InverseBool}}"
                          Height="36" Margin="0,0,0,12" FontSize="13"/>
            </StackPanel>

            <!-- Nombre -->
            <TextBlock Text="NOMBRE" Style="{StaticResource FormLabel}"/>
            <TextBox Style="{StaticResource FormInput}" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

            <!-- Valor -->
            <TextBlock Text="VALOR (%)" Style="{StaticResource FormLabel}"/>
            <TextBox Style="{StaticResource FormInput}" Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

            <!-- FechaDesde -->
            <TextBlock Text="FECHA DESDE (opcional)" Style="{StaticResource FormLabel}"/>
            <DatePicker SelectedDate="{Binding FechaDesde}" Margin="0,0,0,12"/>

            <!-- FechaHasta -->
            <TextBlock Text="FECHA HASTA (opcional)" Style="{StaticResource FormLabel}"/>
            <DatePicker SelectedDate="{Binding FechaHasta}" Margin="0,0,0,12"/>

            <!-- Prioridad -->
            <TextBlock Text="PRIORIDAD" Style="{StaticResource FormLabel}"/>
            <TextBox Style="{StaticResource FormInput}" Text="{Binding Prioridad, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Style="{StaticResource CancelBtn}"
                    cal:Message.Attach="Action:Cancelar"/>
            <Button Content="Eliminar" Style="{StaticResource CancelBtn}"
                    cal:Message.Attach="Action:EliminarAsync"
                    Visibility="{Binding EsModoEdicion, Converter={StaticResource BoolToVisibility}}"
                    Background="#1AEF4444" Foreground="{DynamicResource ErrorBrush}" Margin="8,0,8,0"/>
            <Button Content="Guardar" Style="{StaticResource PrimaryButton}"
                    Height="38" Padding="16,0"
                    cal:Message.Attach="Action:GuardarAsync"/>
        </StackPanel>
    </Grid>
</UserControl>
