<UserControl x:Class="GestionComercial.UI.Views.Descuentos.DescuentoFormularioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cal="http://www.caliburnproject.org"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="CancelBtn" TargetType="Button">
            <Setter Property="Height"          Value="38"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="Margin"          Value="0,0,8,0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="CaretBrush"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeccionCard" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="14"/>
            <Setter Property="Margin"          Value="0,0,0,14"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20" MaxWidth="520" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="{Binding Titulo}" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Error -->
                <Border Background="#1AEF4444" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                        Visibility="{Binding TieneError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding MensajeError}" FontSize="12"
                               Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
                </Border>

                <!-- ── Ámbito (qué se compra) ── -->
                <Border Style="{StaticResource SeccionCard}">
                    <StackPanel>
                        <TextBlock Text="QUÉ SE COMPRA" Style="{StaticResource FormLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton GroupName="Ambito" Content="Producto" FontSize="13"
                                         IsChecked="{Binding AmbitoSeleccionado, Converter={StaticResource StringEquals}, ConverterParameter=Producto}"
                                         Margin="0,0,20,0"/>
                            <RadioButton GroupName="Ambito" Content="Categoría" FontSize="13"
                                         IsChecked="{Binding AmbitoSeleccionado, Converter={StaticResource StringEquals}, ConverterParameter=Categoría}"
                                         Margin="0,0,20,0"/>
                            <RadioButton GroupName="Ambito" Content="Método de Pago" FontSize="13"
                                         IsChecked="{Binding AmbitoSeleccionado, Converter={StaticResource StringEquals}, ConverterParameter=Método de Pago}"/>
                        </StackPanel>

                        <!-- Selector de Producto -->
                        <StackPanel Visibility="{Binding MuestraSelectorProducto, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="PRODUCTO" Style="{StaticResource FormLabel}"/>
                            <ComboBox ItemsSource="{Binding Productos}"
                                      DisplayMemberPath="Nombre"
                                      SelectedItem="{Binding ProductoSeleccionado}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="Nombre"
                                      IsEnabled="{Binding EsModoEdicion, Converter={StaticResource InverseBool}}"
                                      Height="36" FontSize="13"/>
                        </StackPanel>

                        <!-- Selector de Categoría -->
                        <StackPanel Visibility="{Binding MuestraSelectorCategoria, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="CATEGORÍA" Style="{StaticResource FormLabel}"/>
                            <ComboBox ItemsSource="{Binding Categorias}"
                                      DisplayMemberPath="Nombre"
                                      SelectedItem="{Binding CategoriaSeleccionada}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="Nombre"
                                      IsEnabled="{Binding EsModoEdicion, Converter={StaticResource InverseBool}}"
                                      Height="36" FontSize="13"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Condición de Pago ── -->
                <Border Style="{StaticResource SeccionCard}">
                    <StackPanel>
                        <TextBlock Text="CONDICIÓN DE PAGO" Style="{StaticResource FormLabel}"/>
                        <CheckBox Content="Aplica a cualquier método de pago" FontSize="13"
                                  IsChecked="{Binding AplicaCualquierMetodoPago}"
                                  Margin="0,0,0,10">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MuestraAmbitoMetodoPago}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>

                        <StackPanel Visibility="{Binding MuestraSelectorMetodosPago, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Setter Property="Margin" Value="0,0,0,6"/>
                                        <Setter Property="Text" Value="MÉTODOS DE PAGO"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MuestraAmbitoMetodoPago}" Value="False">
                                                <Setter Property="Text" Value="TARJETAS"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding MetodosPagoDisponibles}">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,2"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding MetodoPago.Nombre}" FontSize="13"
                                                  IsChecked="{Binding EstaSeleccionado}"
                                                  Margin="16,2,0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Datos generales ── -->
                <Border Style="{StaticResource SeccionCard}">
                    <StackPanel>
                        <TextBlock Text="DATOS" Style="{StaticResource FormLabel}"/>

                        <TextBlock Text="VALOR (%)" Style="{StaticResource FormLabel}"/>
                        <TextBox Style="{StaticResource FormInput}" Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <TextBlock Text="FECHA DESDE (opcional)" Style="{StaticResource FormLabel}"/>
                        <DatePicker SelectedDate="{Binding FechaDesde}" Margin="0,0,0,12"/>

                        <TextBlock Text="FECHA HASTA (opcional)" Style="{StaticResource FormLabel}"/>
                        <DatePicker SelectedDate="{Binding FechaHasta}" Margin="0,0,0,12"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Style="{StaticResource CancelBtn}"
                    cal:Message.Attach="Cancelar"/>
            <Button Content="Eliminar" Style="{StaticResource CancelBtn}"
                    cal:Message.Attach="EliminarAsync"
                    Visibility="{Binding EsModoEdicion, Converter={StaticResource BoolToVisibility}}"
                    Background="#1AEF4444" Foreground="{DynamicResource ErrorBrush}" Margin="8,0,8,0"/>
            <Button Content="Guardar" Style="{StaticResource PrimaryButton}"
                    Height="38" Padding="16,0"
                    cal:Message.Attach="GuardarAsync"/>
        </StackPanel>
    </Grid>
</UserControl>