<UserControl x:Class="GestionComercial.UI.Views.Caja.AperturaCajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:converters="clr-namespace:GestionComercial.UI.Views.Converters"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:DecimalToMonedaConverter  x:Key="DecimalToMoneda"/>

        <Style x:Key="TurnoButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2" CornerRadius="12"
                                Padding="20,24">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="iconText" Text="{TemplateBinding Tag}"
                                           FontSize="36" HorizontalAlignment="Center"/>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <Border MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="36,32" Margin="0,24">
                <StackPanel>

                    <!-- ── Header ─────────────────────────────────────────── -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,28">
                        <Border Width="60" Height="60" CornerRadius="15"
                                Background="#1A10B981" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="🔓" FontSize="28"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Apertura de Caja" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding SucursalNombre}" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding FechaHoy, StringFormat='dd/MM/yyyy   HH:mm'}"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- ── Último cierre ──────────────────────────────────── -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="16,14" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ÚLTIMO CIERRE" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding UltimoCierre, StringFormat='dd/MM/yyyy  HH:mm'}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                            </StackPanel>

                            <Rectangle Grid.Column="1" Fill="{DynamicResource BorderBrush}" Width="1" Margin="0,4"/>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="SALDO ANTERIOR" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding SaldoAnterior, Converter={StaticResource DecimalToMoneda}}"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           HorizontalAlignment="Right" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ════════════════════════════════════════
                         PASO 1: SELECCIONAR TURNO
                    ════════════════════════════════════════ -->
                    <StackPanel Visibility="{Binding MostrarPaso1, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="PASO 1 — SELECCIONAR TURNO" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Elegí el turno para abrir la caja" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- Mañana -->
                            <Button x:Name="SeleccionarMañana"
                                    Style="{StaticResource TurnoButton}"
                                    Tag="🌅" Margin="0,0,12,0"
                                    Background="#1A3B82F6" BorderBrush="#3B82F6"
                                    CommandParameter="Mañana"
                                    cal:Message.Attach="SeleccionarTurno('Mañana')">
                                <TextBlock Text="Mañana" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>

                            <!-- Tarde -->
                            <Button x:Name="SeleccionarTarde"
                                    Style="{StaticResource TurnoButton}"
                                    Tag="☀️" Margin="0,0,12,0"
                                    Background="#1AF59E0B" BorderBrush="#F59E0B"
                                    cal:Message.Attach="SeleccionarTurno('Tarde')">
                                <TextBlock Text="Tarde" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>

                            <!-- Noche -->
                            <Button x:Name="SeleccionarNoche"
                                    Style="{StaticResource TurnoButton}"
                                    Tag="🌙"
                                    Background="#1A8B5CF6" BorderBrush="#8B5CF6"
                                    cal:Message.Attach="SeleccionarTurno('Noche')">
                                <TextBlock Text="Noche" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                        </StackPanel>

                    </StackPanel>

                    <!-- ════════════════════════════════════════
                         PASO 2: SELECCIONAR CAJA + MONTO
                    ════════════════════════════════════════ -->
                    <StackPanel Visibility="{Binding MostrarPaso2, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="PASO 2 — COMPLETAR APERTURA" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TurnoSeleccionadoDisplay, StringFormat='Turno: {0}'}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,20"/>

                        <!-- Indicador de paso -->
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,8" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✅ Paso 1 completo — " FontSize="12"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                                <Button x:Name="VolverATurnos" Content="Cambiar turno"
                                        FontSize="12" Foreground="{DynamicResource PrimaryBrush}"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Padding="0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Selección de Caja -->
                        <TextBlock Text="CAJA DISPONIBLE" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <ComboBox Style="{StaticResource FilterComboBoxStyle}"
                                  ItemsSource="{Binding CajasDisponibles}"
                                  SelectedItem="{Binding CajaSeleccionada}"
                                  DisplayMemberPath="Nombre"
                                  Margin="0,0,0,16"/>

                        <!-- Monto inicial -->
                        <TextBlock Text="MONTO INICIAL EN CAJA" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1"
                                CornerRadius="10" Margin="0,0,0,6">
                            <Grid Height="58">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="$" FontSize="24" FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           VerticalAlignment="Center" Margin="16,0,8,0"/>
                                <TextBox x:Name="MontoInicial" Grid.Column="1"
                                         Text="{Binding MontoInicial, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontSize="24" FontWeight="Bold"
                                         VerticalContentAlignment="Center" Padding="0,0,16,0"
                                         CaretBrush="{DynamicResource PrimaryBrush}"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="Ingresá el efectivo físico con el que abrís el turno"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,24"/>

                        <!-- Botón Confirmar paso 2 -->
                        <Button x:Name="Confirmar" Height="48" FontSize="14" Margin="0,8,0,0"
                                FontWeight="SemiBold" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="{DynamicResource SuccessBrush}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#CC10B981"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <ProgressBar IsIndeterminate="True" Width="14" Height="14"
                                             Margin="0,0,8,0" BorderThickness="0"
                                             Foreground="White" Background="Transparent"
                                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Text="Abrir Caja" VerticalAlignment="Center" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- ── Botón Cancelar (visible en cualquier paso) ── -->
                    <Button x:Name="Cancelar" Content="Cancelar"
                            Height="44" FontSize="14" Margin="0,20,0,0"
                            Background="{DynamicResource SurfaceBrush}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
