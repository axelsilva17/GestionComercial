<UserControl x:Class="GestionComercial.UI.Views.FeatureShowcaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cal="http://www.caliburnproject.org"
             Width="600" Height="420"
             Background="#1E1E2E">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="GestionComercial — Versión Demo"
                   FontSize="20" FontWeight="Bold" Foreground="#CDD6F4"
                   HorizontalAlignment="Center" Margin="0,0,0,8"/>

        <!-- Feature card -->
        <Border Grid.Row="1" Background="#313244" CornerRadius="16"
                Padding="32" Margin="0,8"
                VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding IconoActual}"
                           FontSize="64" HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>
                <TextBlock Text="{Binding TituloActual}"
                           FontSize="22" FontWeight="SemiBold"
                           Foreground="#CDD6F4" HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>
                <TextBlock Text="{Binding DescripcionActual}"
                           FontSize="14" Foreground="#A6ADC8"
                           TextWrapping="Wrap" TextAlignment="Center"
                           MaxWidth="460" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Progress -->
        <TextBlock Grid.Row="2" Text="{Binding Progreso}"
                   FontSize="12" Foreground="#6C7086"
                   HorizontalAlignment="Center" Margin="0,12,0,0"/>

        <!-- Buttons -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="← Anterior"
                    cal:Message.Attach="Retroceder"
                    IsEnabled="{Binding PuedeRetroceder}"
                    Background="#45475A" Foreground="#CDD6F4"
                    Padding="16,8" FontSize="13"
                    BorderThickness="0" Cursor="Hand"/>

            <Button Grid.Column="2"
                    cal:Message.Attach="Avanzar"
                    Background="#89B4FA" Foreground="#1E1E2E"
                    Padding="16,8" FontSize="13" FontWeight="SemiBold"
                    BorderThickness="0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="Siguiente →"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PuedeAvanzar}" Value="False">
                                <Setter Property="Content" Value="¡Comenzar!"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
