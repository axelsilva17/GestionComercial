<UserControl x:Class="GestionComercial.UI.Views.Ventas.VentaListadoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:converters="clr-namespace:GestionComercial.UI.Views.Converters"
             Background="{DynamicResource BackgroundBrush}"
             PreviewKeyDown="VentaListadoView_PreviewKeyDown">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:DecimalToMonedaConverter  x:Key="DecimalToMoneda"/>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacity"/>

        <Style x:Key="FiltroButton" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VentasGrid" TargetType="DataGrid">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="GridLinesVisibility"      Value="None"/>
            <Setter Property="HeadersVisibility"        Value="Column"/>
            <Setter Property="IsReadOnly"               Value="True"/>
            <Setter Property="CanUserAddRows"           Value="False"/>
            <Setter Property="CanUserDeleteRows"        Value="False"/>
            <Setter Property="CanUserReorderColumns"    Value="False"/>
            <Setter Property="CanUserSortColumns"       Value="False"/>
            <Setter Property="CanUserResizeColumns"     Value="False"/>
            <Setter Property="SelectionMode"            Value="Single"/>
            <Setter Property="SelectionUnit"            Value="FullRow"/>
            <Setter Property="AutoGenerateColumns"      Value="False"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="RowHeight"                Value="52"/>
            <Setter Property="ColumnHeaderHeight"       Value="36"/>
            <Setter Property="RowBackground"            Value="{DynamicResource CardBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceBrush}"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="8,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BackgroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Badge de estado -->
        <Style x:Key="BadgePendiente" TargetType="Border">
            <Setter Property="Background"     Value="#1AF59E0B"/>
            <Setter Property="BorderBrush"    Value="#F59E0B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"   Value="6"/>
            <Setter Property="Padding"        Value="8,3"/>
        </Style>
        <Style x:Key="BadgePagada" TargetType="Border">
            <Setter Property="Background"     Value="#1A10B981"/>
            <Setter Property="BorderBrush"    Value="#10B981"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"   Value="6"/>
            <Setter Property="Padding"        Value="8,3"/>
        </Style>
        <Style x:Key="BadgeEnProceso" TargetType="Border">
            <Setter Property="Background"     Value="#1A38BDF8"/>
            <Setter Property="BorderBrush"    Value="#38BDF8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"   Value="6"/>
            <Setter Property="Padding"        Value="8,3"/>
        </Style>
        <Style x:Key="BadgeAnulada" TargetType="Border">
            <Setter Property="Background"     Value="#1AEF4444"/>
            <Setter Property="BorderBrush"    Value="#EF4444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"   Value="6"/>
            <Setter Property="Padding"        Value="8,3"/>
        </Style>

        <!-- Estilos del drawer lateral (espejo de CompraListadoView) -->
        <Style x:Key="SideLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SideValue" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,14"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- PANEL PRINCIPAL -->
        <Grid Grid.Column="0" Margin="24">
            <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Button x:Name="Volver" Content="← Volver"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        FontSize="13" Cursor="Hand" HorizontalAlignment="Left"
                        Margin="0,0,0,8"/>
                <TextBlock Text="Historial de Ventas"
                           FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Total (pagadas): " FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding TotalFiltrado, Converter={StaticResource DecimalToMoneda}}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource SuccessBrush}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="4,2" Margin="0,0,8,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="Ctrl+N" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </Border>
                <Button x:Name="NuevaVenta"
                        Height="44" Padding="20,0" FontSize="13"
                        Style="{StaticResource PrimaryButton}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="＋" FontSize="15" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Nueva Venta" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            </StackPanel>
        </Grid>

        <!-- Filtros rápidos de fecha -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button x:Name="FiltrarHoy"        Content="hoy"         Height="32" Padding="14,0" FontSize="12" Margin="0,0,8,0"  Style="{StaticResource FiltroButton}" ToolTip="Ctrl+H - Hoy"/>
            <Button x:Name="FiltrarEstaSemana" Content="Esta semana" Height="32" Padding="14,0" FontSize="12" Margin="0,0,8,0"  Style="{StaticResource FiltroButton}" ToolTip="Ctrl+S - Esta semana"/>
            <Button x:Name="FiltrarEsteMes"    Content="Este mes"    Height="32" Padding="14,0" FontSize="12" Margin="0,0,8,0"  Style="{StaticResource FiltroButton}" ToolTip="Ctrl+M - Este mes"/>
            <Button x:Name="FiltrarUltimos30Dias" Content="Últimos 30 días" Height="32" Padding="14,0" FontSize="12" Margin="0,0,24,0" Style="{StaticResource FiltroButton}"/>

            <TextBlock Text="Desde:" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DatePicker SelectedDate="{Binding FechaDesde}" Style="{StaticResource FilterDatePickerStyle}" Margin="0,0,12,0"/>
            <TextBlock Text="Hasta:" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DatePicker SelectedDate="{Binding FechaHasta}" Style="{StaticResource FilterDatePickerStyle}" Margin="0,0,12,0"/>
            <Button x:Name="Buscar" Content="🔍 Buscar" Height="36" Padding="16,0" FontSize="13"
                    Style="{StaticResource PrimaryButton}" ToolTip="Enter - Buscar"/>
        </StackPanel>

        <!-- Filtro por estado -->
        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <TextBlock Text="Filtrar por estado:" FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <ComboBox ItemsSource="{Binding EstadosFiltro}"
                      SelectedItem="{Binding FiltroEstado}"
                      Style="{StaticResource FilterComboBoxStyle}" Width="140"/>
        </StackPanel>

        <!-- Tabla historial -->
        <Border Grid.Row="6" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="12" ClipToBounds="True">
            <Grid>
                <DataGrid Style="{StaticResource VentasGrid}"
                          ItemsSource="{Binding Ventas}"
                          SelectedItem="{Binding VentaSeleccionada}"
                          SelectionChanged="Ventas_SelectionChanged">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding IdVenta, StringFormat='#{0:D5}'}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="Margin" Value="8,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha, StringFormat='dd/MM/yyyy HH:mm'}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="Margin" Value="8,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="CLIENTE" Binding="{Binding ClienteNombre}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="Margin" Value="8,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="VENDEDOR" Binding="{Binding UsuarioNombre}" Width="160">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="Margin" Value="8,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalFinal, Converter={StaticResource DecimalToMoneda}}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="Margin" Value="8,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Badge de estado con color dinámico -->
                    <DataGridTemplateColumn Header="ESTADO" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource BadgePagada}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Estado}" Value="En proceso">
                                                    <Setter Property="Background"     Value="#1A38BDF8"/>
                                                    <Setter Property="BorderBrush"    Value="#38BDF8"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Estado}" Value="Pendiente">
                                                    <Setter Property="Background"     Value="#1AF59E0B"/>
                                                    <Setter Property="BorderBrush"    Value="#F59E0B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Estado}" Value="Anulada">
                                                    <Setter Property="Background"     Value="#1AEF4444"/>
                                                    <Setter Property="BorderBrush"    Value="#EF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Estado}" FontSize="12" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#10B981"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Estado}" Value="En proceso">
                                                        <Setter Property="Foreground" Value="#38BDF8"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Estado}" Value="Pendiente">
                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Estado}" Value="Anulada">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Chevron: affordance del drawer lateral (espejo de CompraListadoView) -->
                    <DataGridTemplateColumn Width="36">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="›" FontSize="20"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                </DataGrid>

                <!-- Banner de error -->
                <Border Background="#1AEF4444" BorderBrush="{DynamicResource ErrorBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16,12"
                        Margin="16" VerticalAlignment="Top"
                        Visibility="{Binding TieneError, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="No se pudo cargar el historial"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource ErrorBrush}"/>
                        <TextBlock Text="{Binding MensajeError}" FontSize="12"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Estado vacío -->
                <Border Background="#CC0F172A" CornerRadius="12"
                        Visibility="{Binding SinResultados, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📭" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="No hay ventas en el período"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="14" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Text="Probá ampliar el rango de fechas o cambiar el filtro de estado."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Hint de lista capada -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10,5" Margin="0,16,16,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Visibility="{Binding ListaCapada, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding MensajeCapa}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Botones de acción sobre la venta seleccionada -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- Cobrar venta pendiente (solo visible cuando el estado es Pendiente) -->
            <Button x:Name="CobrarVenta"
                    Height="40" Padding="18,0" FontSize="13" Margin="0,0,10,0"
                    IsEnabled="{Binding PuedeCobrar}"
                    ToolTip="Cobrar venta pendiente en efectivo">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
                        <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
                        <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Cursor"          Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8" Opacity="{TemplateBinding IsEnabled, Converter={StaticResource BoolToOpacity}}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💵" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Cobrar" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="VerDetalle"
                    Height="40" Padding="18,0" FontSize="13" Margin="0,0,10,0"
                    IsEnabled="{Binding PuedeVerDetalle}"
                    ToolTip="Enter - Ver detalle">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
                        <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
                        <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Cursor"          Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8" Opacity="{TemplateBinding IsEnabled, Converter={StaticResource BoolToOpacity}}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🧾" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Ver / Reimprimir" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="AnularVenta"
                    Height="40" Padding="18,0" FontSize="13"
                    IsEnabled="{Binding PuedeAnular}"
                    ToolTip="Supr - Anular venta">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background"      Value="#1AEF4444"/>
                        <Setter Property="Foreground"      Value="{DynamicResource ErrorBrush}"/>
                        <Setter Property="BorderBrush"     Value="{DynamicResource ErrorBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Cursor"          Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✕" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Anular Venta" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
        </Grid>

        <!-- SIDEBAR DETALLE VENTA (espejo de CompraListadoView) -->
        <Border Grid.Column="1" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                Visibility="{Binding DetalleVenta, Converter={StaticResource NullToVisibility}}">
            <Grid Width="300">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="22,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="DETALLE DE LA VENTA" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0">
                                    <Run Text="#" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Run Text="{Binding DetalleVenta.IdVenta, Mode=OneWay}"
                                         Foreground="{DynamicResource PrimaryBrush}" FontFamily="Consolas"/>
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="CerrarDetalle" Content="✕"
                                    Width="28" Height="28" FontSize="13"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Cursor="Hand" VerticalAlignment="Top" ToolTip="Cerrar detalle"/>
                        </Grid>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,16"/>

                        <TextBlock Text="CLIENTE" Style="{StaticResource SideLabel}"/>
                        <TextBlock Text="{Binding DetalleVenta.ClienteNombre, Mode=OneWay}"
                                   Style="{StaticResource SideValue}" TextWrapping="Wrap"/>

                        <TextBlock Text="FECHA" Style="{StaticResource SideLabel}"/>
                        <TextBlock Text="{Binding DetalleVenta.Fecha, StringFormat='dd/MM/yyyy   HH:mm', Mode=OneWay}"
                                   Style="{StaticResource SideValue}"/>

                        <TextBlock Text="REGISTRADO POR" Style="{StaticResource SideLabel}"/>
                        <TextBlock Text="{Binding DetalleVenta.UsuarioNombre, Mode=OneWay}"
                                   Style="{StaticResource SideValue}"/>

                        <TextBlock Text="ESTADO" Style="{StaticResource SideLabel}"/>
                        <TextBlock Text="{Binding DetalleVenta.Estado, Mode=OneWay}"
                                   Style="{StaticResource SideValue}"/>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,16"/>

                        <!-- Items de la venta -->
                        <TextBlock Text="PRODUCTOS" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                        <ItemsControl ItemsSource="{Binding DetalleVenta.Items, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ProductoNombre}" FontSize="12" FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"
                                                       ToolTip="{Binding ProductoNombre}"/>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,2,0,0">
                                                <Run Text="{Binding Cantidad}"/>
                                                <Run Text=" x "/>
                                                <Run Text="{Binding PrecioUnitario, Converter={StaticResource DecimalToMoneda}}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Subtotal, Converter={StaticResource DecimalToMoneda}}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,8,0,12"/>

                        <Grid>
                            <TextBlock Text="TOTAL" FontWeight="Bold" FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding DetalleVenta.TotalFinal, Converter={StaticResource DecimalToMoneda}, Mode=OneWay}"
                                       FontWeight="Bold" FontSize="20"
                                       Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
