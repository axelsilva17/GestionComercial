<UserControl x:Class="GestionComercial.UI.Views.Controls.ClockTimePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="220" Height="260">
    <Grid Margin="4">
        <!-- Time display -->
        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border x:Name="HourBorder" CornerRadius="6" Padding="8,2" Cursor="Hand"
                        MouseLeftButtonDown="HourBorder_Click" Background="Transparent">
                    <TextBlock x:Name="HourText" Text="00" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Border>
                <TextBlock Text=":" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="2,0"
                           VerticalAlignment="Center"/>
                <Border x:Name="MinuteBorder" CornerRadius="6" Padding="8,2" Cursor="Hand"
                        MouseLeftButtonDown="MinuteBorder_Click" Background="Transparent">
                    <TextBlock x:Name="MinuteText" Text="00" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Clock face -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="180" Height="180" CornerRadius="90"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2">
            <Grid>
                <Canvas x:Name="ClockCanvas" Width="180" Height="180"/>
                <Ellipse x:Name="CenterDot" Width="8" Height="8"
                         Fill="{DynamicResource PrimaryBrush}"
                         Canvas.Left="86" Canvas.Top="86" IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
