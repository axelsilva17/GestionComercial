<UserControl x:Class="GestionComercial.UI.Views.Productos.ImportacionProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GestionComercial.UI.Views.Converters"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:ProgresoPorcentajeConverter x:Key="ProgresoPorcentaje"/>
        <Style x:Key="OpcionCheck" TargetType="CheckBox">
            <Setter Property="Foreground"  Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="Margin"      Value="0,0,0,10"/>
            <Setter Property="Cursor"      Value="Hand"/>
        </Style>
        <Style x:Key="StepCard" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="24"/>
            <Setter Property="Margin"          Value="0,0,0,16"/>
        </Style>
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24" MaxWidth="820">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Header ── -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="← Volver"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        FontSize="13" Cursor="Hand" VerticalAlignment="Center"
                        Margin="0,0,20,0" Click="Volver_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="10,6">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Importar Productos desde Excel" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Cargá masivamente productos con su stock, precios y categorías"
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <!-- ✅ Click conectado -->
                <Button Grid.Column="2" Style="{StaticResource GhostBtn}"
                        Height="38" Padding="14,0" FontSize="12"
                        Click="DescargarPlantilla_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬇ " FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="Descargar plantilla" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel Grid.Row="2">

                <!-- ══ PASO 1: DROPZONE ══ -->
                <Border Style="{StaticResource StepCard}"
                        Visibility="{Binding MostrarDropzone, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource PrimaryBrush}" Margin="0,0,12,0">
                                <TextBlock Text="1" FontSize="13" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Seleccioná el archivo Excel" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                                CornerRadius="12" Padding="0,40" Cursor="Hand"
                                AllowDrop="True"
                                Drop="DropZone_Drop"
                                DragOver="DropZone_DragOver"
                                MouseLeftButtonDown="DropZone_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📂" FontSize="40" HorizontalAlignment="Center"/>
                                <TextBlock Text="Arrastrá el archivo aquí" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                <TextBlock Text="o hacé clic para seleccionar" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Formatos aceptados: .xlsx, .xls" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1AEF4444" CornerRadius="8" Padding="12,8" Margin="0,8,0,0"
                                Visibility="{Binding TieneError, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding MensajeError}" FontSize="12"
                                       Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>



                <!-- ══ PASO 2: PREVIEW ══ -->
                <Border Style="{StaticResource StepCard}"
                        Visibility="{Binding MostrarPreview, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource PrimaryBrush}" Margin="0,0,12,0">
                                    <TextBlock Text="2" FontSize="13" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Vista previa de datos" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding ArchivoNombre}" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- ✅ Click conectado -->
                            <Button Grid.Column="1" Content="✎ Cambiar archivo"
                                    Style="{StaticResource GhostBtn}"
                                    Height="32" Padding="12,0" FontSize="11"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Click="Reiniciar_Click"/>
                        </Grid>

                        <!-- Opciones de importación -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <CheckBox Content="Actualizar precio y stock de productos existentes (por código de barra)"
                                      IsChecked="{Binding ActualizarExistentes}" Style="{StaticResource OpcionCheck}"
                                      Margin="0,0,24,0"/>
                            <CheckBox Content="Crear categorías nuevas si no existen"
                                      IsChecked="{Binding CrearCategorias}" Style="{StaticResource OpcionCheck}"/>
                        </StackPanel>

                        <!-- Badges resumen -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Background="#1A22C55E" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                                <TextBlock FontSize="12" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold">
                                    <Run Text="✓ "/>
                                    <Run Text="{Binding FilasValidas}"/>
                                    <Run Text=" válidas"/>
                                </TextBlock>
                            </Border>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                                <TextBlock FontSize="12" Foreground="{DynamicResource ErrorBrush}" FontWeight="SemiBold">
                                    <Run Text="{Binding FilasConError}"/>
                                    <Run Text=" con error"/>
                                </TextBlock>
                            </Border>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12,6">
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="{Binding FilasTotales}"/>
                                    <Run Text=" total"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <!-- Action bar: Importar arriba + Collapsible toggle -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Botón Importar - SIEMPRE visible arriba -->
                            <Button Grid.Column="0" Style="{StaticResource PrimaryButton}"
                                    Height="38" Padding="20,0" FontSize="13"
                                    IsEnabled="{Binding PuedeImportar}"
                                    Click="EjecutarImportacion_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⬆ " FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="Importar "/>
                                        <Run Text="{Binding FilasValidas}"/>
                                        <Run Text=" productos"/>
                                    </TextBlock>
                                </StackPanel>
                            </Button>

                            <!-- Botón Cancelar -->
                            <Button Grid.Column="1" Content="Cancelar" Style="{StaticResource GhostBtn}"
                                    Height="38" Padding="16,0" Margin="8,0,0,0" FontSize="13"
                                    Click="Cancelar_Click"/>

                            <!-- Toggle collapsible lista (alineado a la derecha) -->
                            <Button Grid.Column="3" Style="{StaticResource GhostBtn}"
                                    Height="32" Padding="14,0" FontSize="12"
                                    Click="ToggleLista_Click">
                                <TextBlock Text="{Binding FlechaListaTexto}" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <!-- Tabla preview - collapsible (virtualized DataGrid) -->
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" ClipToBounds="True"
                                Visibility="{Binding MostrarLista, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Preview notice -->
                                <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                        Padding="12,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AvisoPreview}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding AvisoPreview}" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>

                                <!-- Virtualized DataGrid (AutoGenerateColumns=False, read-only).
                                     MaxHeight is REQUIRED for virtualization: inside this
                                     StackPanel chain the grid otherwise measures at infinite
                                     height and realizes every row. A bounded viewport makes the
                                     internal ScrollViewer + virtualization kick in. -->
                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding FilasPreview}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserResizeRows="False"
                                          EnableRowVirtualization="True"
                                          EnableColumnVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True"
                                          MaxHeight="420"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="None"
                                          BorderThickness="0"
                                          BorderBrush="Transparent"
                                          Background="Transparent"
                                          RowBackground="Transparent"
                                          AlternatingRowBackground="Transparent"
                                          SelectionMode="Single"
                                          CanUserSortColumns="False"
                                          RowHeaderWidth="0">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontSize" Value="10"/>
                                            <Setter Property="Padding" Value="12,8"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EsValida}" Value="False">
                                                    <Setter Property="Background" Value="#08EF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Fila}" Width="36">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="ESTADO" Binding="{Binding EstadoTexto}" Width="72">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="10"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EsValida}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EsNuevo}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="NOMBRE" Binding="{Binding Nombre}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="P. VENTA" Binding="{Binding PrecioVenta, StringFormat=C0}" Width="85">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="TextAlignment" Value="Right"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="P. COSTO" Binding="{Binding PrecioCosto, StringFormat=C0}" Width="85">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="TextAlignment" Value="Right"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="STOCK" Binding="{Binding Stock}" Width="55">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="TextAlignment" Value="Right"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="MÍNIMO" Binding="{Binding StockMinimo}" Width="55">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="TextAlignment" Value="Right"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="MARGEN" Binding="{Binding Margen, StringFormat={}{0:N1} %}" Width="72">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="TextAlignment" Value="Right"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Margen}" Value="0">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="CATEGORÍA" Binding="{Binding Categoria}" Width="82">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="UNIDAD" Binding="{Binding UnidadMedida}" Width="72">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource CardBrush}" Opacity="0.8"
                                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
                                <ProgressBar Grid.Row="0" Grid.RowSpan="2" IsIndeterminate="True" Height="3"
                                             VerticalAlignment="Top" Foreground="{DynamicResource PrimaryBrush}"
                                             BorderThickness="0"
                                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </Border>

                        <!-- Barra progreso importación -->
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16,12"
                                Margin="0,16,0,0"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Importando productos..." FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding TextoProgreso}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <!-- Barra progreso real con porcentaje -->
                                <Grid Height="24">
                                    <Border Background="{DynamicResource BorderBrush}" CornerRadius="4"/>
                                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="4"
                                            HorizontalAlignment="Left"
                                            Width="{Binding Progreso, Converter={StaticResource ProgresoPorcentaje}}"/>
                                    <TextBlock Text="{Binding Progreso, StringFormat={}{0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"
                                               Foreground="White" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- ══ PASO 3: RESULTADO ══ -->
                <Border Style="{StaticResource StepCard}"
                        Visibility="{Binding MostrarResultado, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" Margin="0,20">
                        <TextBlock Text="✅" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="Importación completada" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>

                        <!-- Error en resultado -->
                        <Border Background="#1AEF4444" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                                Visibility="{Binding TieneError, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding MensajeError}" FontSize="12"
                                       Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                            <Border Background="#1A22C55E" CornerRadius="10" Padding="20,12" Margin="6,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Importados}" FontSize="28" FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Nuevos" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1A3B82F6" CornerRadius="10" Padding="20,12" Margin="6,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Actualizados}" FontSize="28" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Actualizados" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="20,12" Margin="6,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Omitidos}" FontSize="28" FontWeight="Bold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Omitidos" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- ✅ Click conectado -->
                            <Button Content="Importar otro archivo" Style="{StaticResource GhostBtn}"
                                    Height="38" Padding="16,0" Margin="0,0,8,0" FontSize="13"
                                    Click="ReiniciarArchivo_Click"/>
                            <!-- ✅ Click conectado -->
                            <Button Style="{StaticResource PrimaryButton}"
                                    Height="38" Padding="20,0" FontSize="13"
                                    Content="Ir a Productos →"
                                    Click="Finalizar_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
